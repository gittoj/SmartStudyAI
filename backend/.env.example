# Copy to backend/.env for local development. In production, set these in the host's dashboard (e.g. Render).

# Plain Postgres URL. Host URLs such as Neon's (postgresql://...?sslmode=require) can be pasted as-is;
# the app converts them for asyncpg. With Neon, use the DIRECT (non-pooled) connection string.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/smartstudy
# Long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))". Never reuse between environments.
SESSION_SECRET=change-me
OPENAI_API_KEY=

# OCR: "tesseract" is free and reads printed text only. "google_vision" also reads handwriting
# (needs GOOGLE_VISION_API_KEY and a Google billing account).
OCR_PROVIDER=tesseract
# Only if Tesseract is not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe (not needed in Docker)
TESSERACT_CMD=
GOOGLE_VISION_API_KEY=
# Free-tier guard: after this many Google OCR pages in a month, fall back to local Tesseract
GOOGLE_VISION_MONTHLY_LIMIT=900

# Browser origin(s) of the Next.js app. Use localhost (not 127.0.0.1) on both sides so cookies are same-site.
CORS_ORIGINS=http://localhost:3000
# false for local http development only. Must be true in production (HTTPS).
COOKIE_SECURE=false

# --- Production behind the Next.js proxy (leave empty locally) ---
# Same value as PROXY_SHARED_SECRET on the frontend. When set, only requests via the proxy are served.
PROXY_SHARED_SECRET=
# Header the proxy fills with the visitor's IP, for login/sign-up rate limits. Use x-client-ip in production.
TRUST_PROXY_HEADER=
