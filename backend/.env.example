DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/smartstudy
SESSION_SECRET=change-me
OPENAI_API_KEY=
# Only if Tesseract is not on PATH, e.g. C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=
STORAGE_DIR=./private_storage
# Handwriting support: use google_vision and add a key (restrict it to the Cloud Vision API)
OCR_PROVIDER=google_vision
GOOGLE_VISION_API_KEY=
# Free-tier guard: after this many Google OCR pages in a month, fall back to local Tesseract
GOOGLE_VISION_MONTHLY_LIMIT=900
# Browser origin(s) of the Next.js app. Use localhost (not 127.0.0.1) on both sides so cookies are same-site.
CORS_ORIGINS=http://localhost:3000
# For local http development only:
COOKIE_SECURE=false
