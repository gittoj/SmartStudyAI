# Local development: the browser calls the backend directly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (set in Vercel, not here):
#   NEXT_PUBLIC_API_URL=/                       same-origin; proxy.ts forwards /api/* to the backend
#   BACKEND_URL=https://<your-app>.onrender.com server-only
#   PROXY_SHARED_SECRET=<same value as backend> server-only
